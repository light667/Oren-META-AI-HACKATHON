# Copier ce fichier en .env.local et remplir les valeurs. Ne jamais commiter .env.local.

# Produit (visible côté client)
NEXT_PUBLIC_PRODUCT_NAME=Oren
# URL publique du site (SEO : sitemap, robots, Open Graph). Ex. https://oren.vercel.app
NEXT_PUBLIC_SITE_URL=

# Meta Model API — clé créée dans le dashboard dev.meta.ai (API keys > Create API key)
# Nom canonique documenté par Meta : MODEL_API_KEY. META_API_KEY est accepté en repli.
MODEL_API_KEY=
META_API_KEY=

# Optionnel : surcharges (valeurs par défaut issues de la documentation officielle)
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_CHAT_MODEL=muse-spark-1.3
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# Fichier audio pour le test (e) du smoke test (défaut : test/voix.m4a ou test/voix.wav)
SMOKE_AUDIO_PATH=

# Alertes patron (tableau temps réel, Web Push, e-mail de secours)
# Générer les clés VAPID : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@exemple.tg
RESEND_API_KEY=
EMAIL_FROM=
# Secret partagé avec le déclencheur externe (cron-job.org, toutes les minutes).
# Voir docs/ALERTES_CRON.md : en-tête « x-cron-secret » sur /api/cron/order-alerts.
CRON_SECRET=
ORDER_ALERT_DELAY_MINUTES=3

# Protection de la clé API sur les routes publiques /api/chat/[slug]
# (compteurs par instance, avant tout appel au modèle ; voir AGENTS.md)
CHAT_RATE_LIMIT_PER_MINUTE_SESSION=12
CHAT_RATE_LIMIT_PER_MINUTE_IP=60
CHAT_DAILY_LIMIT_PER_BUSINESS=1000

# Supabase (tâches suivantes, pas encore utilisé)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vidéo de démonstration (scripts/demo-record.ts) — compte et entreprise créés
# par le script via l'API admin Supabase. N'utiliser que des adresses factices
# réservées (.example) : aucun e-mail ni aucune clé ne doit apparaître à l'écran.
# DEMO_URL : base du produit en cours d'exécution (défaut ci-dessous).
DEMO_URL=http://localhost:3000
DEMO_EMAIL=demo-video@oren.example
DEMO_BUSINESS_NAME=Chez Chef T
DEMO_BUSINESS_SLUG=chez-chef-t
# Fichiers d'entrée de la mise en route (photo du menu, voix des horaires).
DEMO_MENU_PHOTO=scripts/demo-assets/menu.jpg
DEMO_VOICE_AUDIO=test/voix.wav
